# ---------- Genel ----------
PORT=8080
TZ=Europe/Istanbul
PUBLIC_URL=https://senin-domainin.com      # Telegram webhook icin disaridan erisilebilir adres

# ---------- Yayin takvimi ----------
# 0=Pazar 1=Pazartesi 2=Sali 3=Carsamba 4=Persembe 5=Cuma 6=Cumartesi
PUBLISH_DAYS=1,3,5                         # haftada 3 gonderi: Pzt, Car, Cum
PUBLISH_TIME=19:00
LEAD_MINUTES=90                            # yayindan kac dk once onaya gonderilsin

# ---------- Telegram ----------
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_CHAT_ID=123456789                 # onaylarin gelecegi sohbet (senin kullanici id'in)
TELEGRAM_WEBHOOK_SECRET=uzun-rastgele-bir-string

# ---------- Instagram (Meta Graph API) ----------
GRAPH_VERSION=v23.0
IG_USER_ID=17841400000000000               # Instagram Business hesabinin ID'si
IG_ACCESS_TOKEN=EAAG...                    # uzun omurlu Page access token

# ---------- Supabase (veritabani + gorsel barindirma) ----------
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...                # service_role key (sadece sunucuda!)
SUPABASE_BUCKET=instagram

# ---------- Aciklama uretimi ----------
ANTHROPIC_API_KEY=sk-ant-...
CAPTION_MODEL=claude-sonnet-4-5

# ---------- Marka ----------
BRAND_NAME=Uraflow
BRAND_HANDLE=@uraflow
BRAND_COLOR=#0B1221
BRAND_ACCENT=#3DDC97
