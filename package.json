{
  "name": "insta-otomasyon",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Instagram icerik otomasyonu: haftada 3 gonderi, sablon tabanli gorsel uretimi, AI aciklama, Telegram onayi",
  "main": "src/index.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "dev": "node --env-file-if-exists=.env --watch src/index.js",
    "preview": "node --env-file-if-exists=.env scripts/preview.js",
    "webhook": "node --env-file-if-exists=.env scripts/setup-webhook.js",
    "gen": "node --env-file-if-exists=.env scripts/run-once.js generate",
    "pub": "node --env-file-if-exists=.env scripts/run-once.js publish",
    "takvim": "node --env-file-if-exists=.env scripts/takvim.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.1",
    "@supabase/supabase-js": "^2.45.4",
    "express": "^4.21.1",
    "node-cron": "^3.0.3",
    "puppeteer": "^23.6.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
